generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model blacklists {
  discord_id String @unique(map: "discord_id") @db.VarChar(32)
}

model cooldowns {
  id         Int      @id @default(autoincrement())
  discord_id String   @db.VarChar(32)
  timestamp  DateTime @db.DateTime(0)
  game       String   @db.VarChar(64)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model online_staff {
  discord_id String @db.VarChar(32)
  staff      staff  @relation(fields: [discord_id], references: [discord_id], onDelete: Cascade, map: "tester_FK")

  @@index([discord_id], map: "tester_FK")
  @@ignore
}

model punishments {
  id          Int       @id @default(autoincrement())
  discord_id  String    @db.VarChar(32)
  uuid        String?   @db.VarChar(64)
  nick        String?   @db.VarChar(16)
  is_premium  Boolean
  punisher_id String    @db.VarChar(32)
  applied     DateTime  @db.DateTime(0)
  expiration  DateTime? @db.DateTime(0)
  reason      String    @db.Text
  is_cheater  Boolean
}

model staff {
  discord_id        String         @unique(map: "discord_id") @db.VarChar(32)
  uuid              String?        @db.VarChar(64)
  nick              String?        @db.VarChar(16)
  is_premium        Boolean?
  staff_role_id     String         @db.VarChar(32)
  staff_role_name   String         @db.VarChar(64)
  staff_role_colour String         @db.VarChar(7)
  staff_role_weight Int
  online_staff      online_staff[] @ignore
}

model applications {
  id                   Int      @id @default(autoincrement())
  nombre               String   @db.VarChar(60)
  discord              String   @db.VarChar(32)
  tipo                 String   @db.VarChar(16)
  edad                 Int
  labor_helper         String   @db.Text
  funciones_helper     String   @db.Text
  claro_spam           Boolean
  detalle_spam         String?  @db.Text
  claro_flood          Boolean
  detalle_flood        String?  @db.Text
  conoce_hacks_ss      Boolean
  detalle_hacks_ss     String?  @db.Text
  opinion_tierlist     String   @db.Text
  usuarios_peleando    String   @db.Text
  testers_peleando     String   @db.Text
  ticket_tester        String   @db.Text
  ticket_reporte       String   @db.Text
  hacks_pvp            String   @db.Text
  tiempo_disciplina    Boolean
  meta_principal       String   @db.Text
  capacidad_resolucion Boolean
  se_enoja_facil       Boolean
  ip_hash              String?  @db.VarChar(64)
  created_at           DateTime @db.DateTime(0)
  status               String   @default("pendiente") @db.VarChar(16)
  acepta_terminos      Boolean  @default(false)
  terminos_version     String?  @db.VarChar(16)

  @@index([discord, tipo, created_at], map: "discord_tipo_created")
  @@map("applications")
}

model tester_applications {
  id                  Int      @id @default(autoincrement())
  nombre              String   @db.VarChar(60)
  discord             String   @db.VarChar(32)
  tipo                String   @db.VarChar(16)
  edad                Int
  region              String   @db.VarChar(60)
  modos               String   @db.VarChar(80)
  tier_modo           String   @db.Text
  experiencia_tester  Boolean
  detalle_experiencia String?  @db.Text
  baneado             Boolean
  detalle_baneado     String?  @db.Text
  uso_cheats          Boolean
  opinion_navy        String   @db.Text
  por_que_tester      String   @db.Text
  tiempo_testeos      String   @db.Text
  servidores          String   @db.Text
  clanes_pvp          Boolean
  detalle_clanes      String?  @db.Text
  toxico              Boolean
  sospecha_hacks      String   @db.Text
  ip_hash             String?  @db.VarChar(64)
  status              String   @default("pendiente") @db.VarChar(16)
  created_at          DateTime @db.DateTime(0)
  acepta_terminos     Boolean  @default(false)
  terminos_version    String?  @db.VarChar(16)

  @@index([discord, tipo, created_at], map: "discord_tipo_created_tester")
  @@map("tester_applications")
}

model admin_users {
  id            Int      @id @default(autoincrement())
  username      String   @unique(map: "username") @db.VarChar(60)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @db.DateTime(0)
  /// 'admin' | 'founder'. Añadido a mano: prisma/manual-migrations/2026-09-28-admin-roles.sql
  role          String   @default("admin") @db.VarChar(16)

  @@map("admin_users")
}

model api_cache {
  cache_key  String   @id @db.VarChar(255)
  data       String   @db.LongText
  created_at DateTime @db.DateTime(0)
  expires_at DateTime @db.DateTime(0)

  @@map("api_cache")
}

model tier_testers {
  discord_id String @unique(map: "discord_id") @db.VarChar(32)
  count      Int
}

model tiers {
  id         Int      @id @default(autoincrement())
  uuid       String?  @db.VarChar(64)
  nick       String?  @db.VarChar(32)
  is_premium Boolean
  discord_id String   @db.VarChar(32)
  tester_id  String   @db.VarChar(32)
  game       String   @db.VarChar(32)
  region     String   @db.VarChar(32)
  tier       String   @db.VarChar(16)
  is_high    Boolean
  date       DateTime @db.DateTime(0)
}

/// Overrides del panel admin sobre tablas que sincroniza el bot (staff, punishments, tiers).
/// Escrito a mano: ver prisma/manual-migrations/2026-09-28-admin-dashboard.sql
model admin_overrides {
  id              Int       @id @default(autoincrement())
  entity          String    @db.VarChar(16)
  entity_key      String    @db.VarChar(80)
  nick            String?   @db.VarChar(32)
  role_name       String?   @db.VarChar(64)
  role_colour     String?   @db.VarChar(7)
  role_weight     Int?
  reason          String?   @db.Text
  is_cheater      Boolean?
  expiration_mode String?   @db.VarChar(10)
  expiration      DateTime? @db.DateTime(0)
  hidden_at       DateTime? @db.DateTime(0)
  hidden_reason   String?   @db.VarChar(255)
  updated_by      String    @db.VarChar(60)
  updated_at      DateTime  @db.DateTime(0)

  @@unique([entity, entity_key], map: "entity_entity_key")
  @@map("admin_overrides")
}

/// Auditoría de acciones del panel admin.
model admin_audit_log {
  id             Int      @id @default(autoincrement())
  admin_username String   @db.VarChar(60)
  action         String   @db.VarChar(32)
  entity         String?  @db.VarChar(16)
  entity_key     String?  @db.VarChar(80)
  before_data    String?  @db.Text
  after_data     String?  @db.Text
  created_at     DateTime @db.DateTime(0)

  @@index([created_at], map: "created_at_idx")
  @@index([entity, entity_key], map: "entity_idx")
  @@map("admin_audit_log")
}

/// Perfil público del staff (redes, bio, estado) editado desde el panel.
/// Escrito a mano: ver prisma/manual-migrations/2026-09-30-staff-profiles.sql
model staff_profiles {
  discord_id       String   @id @db.VarChar(32)
  bio              String?  @db.VarChar(160)
  status_mode      String?  @db.VarChar(10)
  instagram        String?  @db.VarChar(40)
  tiktok           String?  @db.VarChar(40)
  youtube          String?  @db.VarChar(60)
  twitch           String?  @db.VarChar(40)
  x                String?  @db.VarChar(40)
  discord_username String?  @db.VarChar(40)
  github           String?  @db.VarChar(40)
  linkedin         String?  @db.VarChar(100)
  show_namemc      Boolean  @default(true)
  updated_by       String   @db.VarChar(60)
  updated_at       DateTime @db.DateTime(0)

  @@map("staff_profiles")
}
